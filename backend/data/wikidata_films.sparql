# CineAtlas curated starter selection. IMDb IDs are used only as lookup keys;
# all returned metadata comes from Wikidata (CC0 structured data).
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX psv: <http://www.wikidata.org/prop/statement/value/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?film ?title (MIN(YEAR(?date)) AS ?year)
       (GROUP_CONCAT(DISTINCT ?genreLabel; separator="|") AS ?genres)
       (MIN(?minutes) AS ?runtime) ?imdb
WHERE {
  VALUES ?imdb {
    "tt0111161" "tt0068646" "tt0071562" "tt0468569" "tt0050083"
    "tt0108052" "tt0110912" "tt0167260" "tt0120737" "tt0167261"
    "tt0109830" "tt0137523" "tt1375666" "tt0080684" "tt0133093"
    "tt0099685" "tt0073486" "tt0114369" "tt0102926" "tt0120815"
    "tt0816692" "tt0118799" "tt0120689" "tt0076759" "tt0245429"
    "tt0038650" "tt0047478" "tt0088763" "tt0209144" "tt0482571"
    "tt0407887" "tt0253474" "tt0172495" "tt0082971" "tt0211915"
    "tt0110357" "tt0910970" "tt1049413" "tt0266543" "tt0114709"
    "tt6751668" "tt2582802" "tt1853728" "tt7286456" "tt4154796"
    "tt0081505" "tt0084787" "tt0090605" "tt0078748" "tt0120338"
    "tt0110413" "tt0338013" "tt0103064" "tt0093058" "tt0325980"
    "tt0372784" "tt0114814" "tt2267998" "tt1392190" "tt1454468"
  }
  ?film wdt:P345 ?imdb ; wdt:P577 ?date .
  # Exclude the separately cataloged Encore version; use the original
  # Avengers: Endgame entity for the curated IMDb title identifier.
  FILTER(?film != wd:Q141755993)
  FILTER(?imdb != "tt4154796" || ?film = wd:Q23781155)

  # English labels may be inherited from the language-independent default.
  OPTIONAL { ?film rdfs:label ?titleEn . FILTER(LANG(?titleEn) = "en") }
  OPTIONAL { ?film rdfs:label ?titleMul . FILTER(LANG(?titleMul) = "mul") }
  BIND(COALESCE(?titleEn, ?titleMul) AS ?title)
  FILTER(BOUND(?title))
  OPTIONAL {
    ?film wdt:P136 ?genre .
    OPTIONAL { ?genre rdfs:label ?genreEn . FILTER(LANG(?genreEn) = "en") }
    OPTIONAL { ?genre rdfs:label ?genreMul . FILTER(LANG(?genreMul) = "mul") }
    BIND(COALESCE(?genreEn, ?genreMul) AS ?genreLabel)
    FILTER(BOUND(?genreLabel))
  }
  OPTIONAL {
    ?film p:P2047/psv:P2047 ?duration .
    ?duration wikibase:quantityUnit wd:Q7727 ; wikibase:quantityAmount ?minutes .
    FILTER(?minutes >= 1 && ?minutes <= 10000)
  }
}
GROUP BY ?imdb ?film ?title
ORDER BY ?imdb ?film
